{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "etaon",
  "main": "./worker.js",
  "compatibility_date": "2026-07-26",
  "workers_dev": true,
  "assets": {
    "directory": "./brand-center",
    "binding": "ASSETS",
    "run_worker_first": ["/downloads/*"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  }
}
